        "largest": 1.7976931348623157e+308
      },
      "encoded": "{\"belowFixedThreshold\":1e-7,\"fixedThreshold\":0.000001,\"largeFixed\":100000000000000000000,\"largeRoundedInteger\":1000000000000000100,\"largest\":1.7976931348623157e+308,\"negativeZero\":0,\"scientificThreshold\":1e+21,\"smallest\":5e-324}"
