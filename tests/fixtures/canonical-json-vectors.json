{
  "comment": "Shared conformance vectors, generated by scripts/build-canonical-json-vectors.mjs. The TypeScript canonicalJson and the Swift CanonicalJSON.encode must both produce `encoded` for `value`. Signature payloads are only interoperable while they agree.",
  "vectors": [
    {
      "name": "keys sort by UTF-16 code unit, not case-insensitively",
      "value": {
        "b": 1,
        "A": 2,
        "a": 3,
        "B": 4
      },
      "encoded": "{\"A\":2,\"B\":4,\"a\":3,\"b\":1}"
    },
    {
      "name": "digit runs sort lexicographically, not numerically",
      "value": {
        "item10": 1,
        "item9": 2,
        "item1": 3
      },
      "encoded": "{\"item1\":3,\"item10\":1,\"item9\":2}"
    },
    {
      "name": "underscore and hyphen order by code unit",
      "value": {
        "a_b": 1,
        "a-b": 2,
        "aQb": 3
      },
      "encoded": "{\"a-b\":2,\"aQb\":3,\"a_b\":1}"
    },
    {
      "name": "nested objects sort at every level",
      "value": {
        "outer": {
          "z": 1,
          "a": {
            "y": 2,
            "b": 3
          }
