            "c": 2
          }
        ]
      },
      "encoded": "{\"first\":[{\"c\":2,\"d\":1}],\"outer\":{\"a\":{\"b\":3,\"y\":2},\"z\":1}}"
    },
    {
      "name": "forward slashes and non-ASCII are not escaped",
      "value": {
